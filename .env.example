# Copy to .env and fill in values. Never commit real secrets.

# Website HTML → Markdown (ingestion) + default embed/generate provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Optional: set RAG_*_PROVIDER=gemini when Gemini billing is available
GEMINI_API_KEY=
RAG_EMBED_PROVIDER=cloudflare
RAG_GENERATE_PROVIDER=cloudflare

# API
RAG_CORS_ORIGINS=http://localhost:3000,https://joseoclaudio.com
RAG_RATE_LIMIT_PER_MINUTE=8
